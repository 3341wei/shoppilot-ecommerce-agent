# ============================================================
# 环境变量模板：复制为 .env 后填入自己的密钥
#   cp .env.example .env
# .env 已被 .gitignore 忽略，绝不要提交
# ============================================================

# ---------------- 运行环境 ----------------
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=text

# 允许跨域的前端来源，逗号分隔；留空表示同源
CORS_ORIGINS=

# ---------------- 访问控制 ----------------
# 留空：development 下跳过鉴权（仅本机调试）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
INGEST_RATE_LIMIT_REQUESTS=3
INGEST_RATE_LIMIT_WINDOW_SECONDS=3600

# 演示身份头（X-User-Role / X-User-Id）；生产必须关闭并接 JWT
DEMO_ROLE_HEADER_ENABLED=true

# 限流取客户端 IP 时是否信任 X-Forwarded-For；仅在可信反向代理后开启
TRUST_PROXY_HEADERS=false

# ---------------- LLM ----------------
# https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---------------- Embedding / Rerank（可选） ----------------
# 留空时自动降级为纯 BM25 检索，项目仍可运行
# https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBED_MODEL=BAAI/bge-large-zh-v1.5
EMBED_BATCH_SIZE=32
HTTP_TIMEOUT_SECONDS=30
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------------- 数据与索引 ----------------
DATA_DIR=./data
DB_PATH=./data/shop.db
CHROMA_DIR=./chroma_db

# ---------------- 检索 ----------------
CHUNK_SIZE=420
CHUNK_OVERLAP=40
TOP_K=3
RECALL_K=15
RERANK_TOP_K=3

# ---------------- Agent ----------------
STREAM_ENABLED=true
AGENT_MAX_TOOL_CALLS=6
PENDING_ACTION_TTL_SECONDS=300
